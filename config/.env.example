# Smarketer Pro — database credentials (EXAMPLE ONLY — never commit real values).
#
# Copy to config/.env (gitignored, never committed) on hosts where true
# process environment variables cannot be set (e.g. cPanel shared hosting),
# then fill in the four values and chmod 0600 the file.
#
# Resolution order (see config/db.php):
#   1. DB_HOST / DB_NAME / DB_USER / DB_PASS environment variables (always win)
#   2. config/.env (this format) — silently skipped when absent
#   3. fail closed: the app refuses to start without all four values
#
# Prefer real environment variables where your host supports them; use this
# file only as the shared-hosting fallback.

DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=
